# This is an example .env file. Copy this to a new file named .env and fill in the values.

# Database configuration
MARIADB_ROOT_PASSWORD=your_mariadb_root_password
MARIADB_USER=your_mariadb_user
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=your_mariadb_database

# MinIO configuration
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
MINIO_ENDPOINT=your_minio_endpoint

# JWT configuration
JWT_SECRET=supersecretkey123

# Admin credentials for the backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Grafana configuration
GF_SECURITY_ADMIN_PASSWORD=admin